# spura-gui/.env.example
# The public URL of the Spura backend API.
# This value is baked into the build (NEXT_PUBLIC_*), so it must be set in your
# hosting provider's environment variables BEFORE the build, not at runtime.
#
# For Vercel deployment:
#   Set NEXT_PUBLIC_API_URL in Vercel > Project > Settings > Environment Variables
#   to your public backend URL, e.g. https://spura-engine.onrender.com
#
# Local dev (backend on port 8000): http://localhost:8000
# Local dev (backend on port 8001): http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8000
