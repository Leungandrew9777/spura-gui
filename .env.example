# spura-gui/.env.example
# The public URL of the Spura backend API.
# - Local dev (backend on port 8000): http://localhost:8000
# - Via Cloudflare tunnel to your local backend: https://<your-tunnel>.trycloudflare.com
# Copy this file to .env.local and set the value for local development.
NEXT_PUBLIC_API_URL=http://localhost:8000
